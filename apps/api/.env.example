NODE_ENV=development
PORT=4000

# replicaSet=rs0 matches docker-compose.yml's single-node replica set,
# required for the multi-document transactions used in workspace creation.
MONGODB_URI=mongodb://localhost:27017/supportai?replicaSet=rs0
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
WIDGET_TOKEN_SECRET=change-me-widget-secret-min-32-chars-long

WEB_APP_URL=http://localhost:5173
# Leave unset unless frontend and backend share a parent domain in production
# (e.g. app.example.com / api.example.com sharing .example.com).
COOKIE_DOMAIN=

# AI providers — set the ones you use; workspaces select a provider in AISetting
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — without it, invite/password-reset emails are logged and skipped
# rather than sent. onboarding@resend.dev works with no domain verification.
RESEND_API_KEY=
EMAIL_FROM=SupportAI <onboarding@resend.dev>
