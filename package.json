{
  "name": "supportai",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:api": "pnpm --filter @supportai/api dev",
    "dev:web": "pnpm --filter @supportai/web dev",
    "build": "pnpm --filter @supportai/api build && pnpm --filter @supportai/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
